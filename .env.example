# Copy this file to .env and fill in your own values.

PORT=3000

# Used to sign login tokens. Change this to a long random string before
# going live — anyone who has it can forge logins.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored. Leave as-is for local/free use.
# DB_PATH=./data/flowmember.sqlite

# Set this to use Postgres instead of local SQLite (see src/db.postgres.js).
# Required on Render's free tier if you want data to survive
# redeploys/restarts, since its disk is ephemeral. A free Neon
# (https://neon.tech) database works fine — paste its connection string here.
# DATABASE_URL=postgres://user:pass@host/dbname

# Comma-separated owner emails that get unlimited access to every plan
# (bypasses site/member limits entirely), regardless of their own `plan`
# column. Applied automatically on signup/login — no DB edit needed.
# SUPER_ADMIN_EMAILS=you@example.com,teammate@example.com

# SSLCommerz checkout for Pro/Business upgrades (see src/routes/billing.js).
# Get a free sandbox Store ID/Password at
# https://developer.sslcommerz.com/registration/ — no real business
# verification needed for sandbox testing. Without these set, the upgrade
# buttons will show a "Billing is not configured yet" error.
# SSLCOMMERZ_STORE_ID=your_store_id
# SSLCOMMERZ_STORE_PASSWORD=your_store_password
# Leave unset (or "false") for the sandbox gateway; set to "true" once you
# have real, live SSLCommerz merchant credentials.
# SSLCOMMERZ_IS_LIVE=false
